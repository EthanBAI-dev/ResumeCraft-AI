# Next.js 服务端用于转发 PDF 导出请求；本地运行 Worker 时保持此默认值。
PDF_WORKER_URL=http://127.0.0.1:3001

# AI Provider（只在服务端读取；选择一家配置即可）
AI_DEFAULT_MODEL=openai:gpt-5.6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=

# 统一韧性预算：AI SDK 负责执行重试和总/单步超时
AI_MAX_RETRIES=2
AI_TOTAL_TIMEOUT_MS=15000
AI_STEP_TIMEOUT_MS=10000
