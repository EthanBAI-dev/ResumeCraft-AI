# Next.js 服务端用于转发 PDF 导出请求；本地运行 Worker 时保持此默认值。
PDF_WORKER_URL=http://127.0.0.1:3001

# AI Provider（只在服务端读取；选择一家配置即可）
# 网站默认使用用户自带 DeepSeek Key；生产环境不使用下面的站长密钥。
# 仅限本机 next dev 调试时可设 true；线上即使设 true 也不会启用。
AI_ALLOW_SERVER_KEY=false
# 必须将 your-model-id 替换为服务商实际支持的模型 ID。
AI_DEFAULT_MODEL=openai:your-model-id
# 使用 DeepSeek 时可改为：AI_DEFAULT_MODEL=deepseek:deepseek-flash
# 模型可用性以账户为准；短文本任务默认关闭思考模式。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=

# 统一韧性预算：AI SDK 负责执行重试和总/单步超时
AI_MAX_RETRIES=2
# 结构校验失败后的额外生成次数（0–2）
AI_SCHEMA_RETRIES=1
AI_TOTAL_TIMEOUT_MS=15000
AI_STEP_TIMEOUT_MS=10000
